# Scaleway credentials (IAM API key) - never commit real values
SCW_ACCESS_KEY=SCWXXXXXXXXXXXXXXXXX
SCW_SECRET_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: Scaleway project ID (uses default project if omitted)
# SCW_DEFAULT_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Value returned by the get_app_name MCP tool
SCW_APPLICATION_NAME=my-mcp-server
